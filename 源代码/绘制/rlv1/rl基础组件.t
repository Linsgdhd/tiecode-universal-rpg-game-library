类 rl组件容器v2 : rl基础组件
	变量 容器 : 集合
	变量 _根容器 : 逻辑型 = 假

	方法 添加组件(组件 : rl基础组件)
		如果 是否存在(组件.组件id) 则
			返回
		否则
			组件.即将创建(本对象)
			组件.父组件 = 本对象
			容器.添加成员(组件)
			组件.创建完毕(本对象)
		结束 如果
	结束 方法
	
	方法 测量(目标 : rl基础组件 = 空)
		如果 目标 == 空 则
			循环(i, 0, 容器.长度)
				变量 组件 : rl基础组件 = 容器.取成员(i) 为 rl基础组件
				如果 组件.可用 则
					组件.xstart() = xstart() + 左外边距() + 左内边距() + 外边距() + 内边距() + 组件.外边距 + 组件.左外边距
					组件.ystart() = ystart() + 上外边距() + 上内边距() + 外边距() + 内边距() + 组件.外边距 + 组件.上外边距
					如果(组件.宽度 <= -1)
						组件.xend() = xend() - (右内边距() + 内边距() + 组件.外边距 + 组件.右外边距)
					否则(组件.宽度 == 0)
						组件.xend() = 组件.xstart()
					否则
						变量 txe : 整数 = 组件.宽度 + 组件.xstart()
						如果 txe > xend() 则
							
						否则
							
						结束 如果
					结束 如果
				结束 如果
			结束 循环
		否则
			
		结束 如果
	结束 方法

	方法 获取组件(组件id : 整数) : rl基础组件
		循环(容器.枚举器.还有下一个)
			变量 组件 : rl基础组件 = 容器.枚举器.下一个 为 rl基础组件
			如果 组件.组件id == 组件id 则
				返回 组件
			结束 如果
		结束 循环
		返回 空
	结束 方法

	方法 是否存在(组件id : 整数) : 逻辑型
		返回 取反(获取组件(组件id) == 空)
	结束 方法
	
	方法 是否存在_基于对象判断(组件 : rl基础组件) : 逻辑型
		返回 容器.是否存在(组件)
	结束 方法

	方法 删除组件(组件id : 整数)
		容器.删除成员2(获取组件(组件id))
	结束 方法
	
	方法 删除组件_基于对象(组件 : rl基础组件)
		容器.删除成员2(组件)
	结束 方法

	方法 组件数量() : 整数
		返回 容器.长度
	结束 方法
结束 类


